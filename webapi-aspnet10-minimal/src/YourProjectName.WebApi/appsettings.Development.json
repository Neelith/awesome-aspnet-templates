{
  "ConnectionStrings": {
    "YourProjectNameDb": "Host=localhost;Port=5432;Database=postgres;Username=postgres;Password=postgres;Pooling=true"
  },
  "RedisSettings": {
    "ConnectionString": "localhost:6379",
    "KeyPrefix": "dev"
  },
  "JwtSettings": {
    "Authority": "http://localhost:9000/realms/yourrealm",
    "Issuer": "http://localhost:9000/realms/yourrealm",
    "Audience": "account"
  },
  "Serilog": {
    "Using": [ "Serilog.Sinks.Console", "Serilog.Sinks.OpenTelemetry", "Serilog.Enrichers.Span" ],
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Information"
      }
    },
    "WriteTo": [
      {
        "Name": "Console",
        "Args": {
          "formatter": "Serilog.Formatting.Compact.CompactJsonFormatter, Serilog.Formatting.Compact"
        }
      },
      {
        "Name": "File",
        "Args": {
          "path": "log-.txt",
          "rollingInterval": "Day",
          "rollOnFileSizeLimit": true,
          "formatter": "Serilog.Formatting.Compact.CompactJsonFormatter, Serilog.Formatting.Compact"
        }
      },
      {
        "Name": "OpenTelemetry",
        "Args": {
          "endpoint": "http://localhost:4317",
          "protocol": "Grpc",
          "resourceAttributes": {
            "service.name": "YourProjectName.WebApi",
            "service.version": "1.0.0"
          }
        }
      }
    ],
    "Enrich": [
      "FromLogContext",
      "WithMachineName",
      "WithThreadId",
      "WithSpan"
    ]
  }
}
