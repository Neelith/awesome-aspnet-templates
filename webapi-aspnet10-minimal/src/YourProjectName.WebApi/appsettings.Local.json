{
    "ConnectionStrings": {
        "YourProjectNameDb": "Host=postgres-compose;Port=5432;Database=postgres;Username=postgres;Password=postgres;Pooling=true"
    },
  "RedisSettings": {
    "ConnectionString": "redis-compose:6379",
    "KeyPrefix": "dev"
  },
  "JwtSettings": {
    "Authority": "http://keycloak-compose:8080/realms/yourrealm",
    "Issuer": "http://localhost:5000/realms/yourrealm",
    "Audience": "account"
  },
    "Serilog": {
        "Using": [ "Serilog.Sinks.Console", "Serilog.Sinks.OpenTelemetry", "Serilog.Enrichers.Span" ],
        "MinimumLevel": {
            "Default": "Debug",
            "Override": {
                "Microsoft": "Debug"
            }
        },
        "WriteTo": [
            {
                "Name": "Console",
                "Args": {
                    "outputTemplate": "[{Timestamp:HH:mm:ss} {Level:u3} {TraceId}] {Message:lj} {NewLine}{Exception}"
                }
            },
            {
                "Name": "OpenTelemetry",
                "Args": {
                    "endpoint": "http://localhost:4317",
                    "protocol": "Grpc",
                    "resourceAttributes": {
                        "service.name": "YourProjectName.WebApi",
                        "service.version": "1.0.0"
                    }
                }
            }
        ],
        "Enrich": [
            "FromLogContext",
            "WithMachineName",
            "WithThreadId",
            "WithSpan"
        ]
    }
}
