{
  "$schema": "http://json.schemastore.org/template",
  "author": "Alessandro Averna",
  "classifications": ["WebApi", "Clean Architecture", "CQRS", "ASP.NET"],
  "identity": "Awesome.AspnetMinimal.WebApi",
  "name": "ASP.NET 10 Minimal WebApi (Clean Architecture + CQRS)",
  "shortName": "aspnet-minimal",
  "tags": {
    "language": "C#",
    "type": "solution"
  },
  "sourceName": "YourProjectName",
  "preferNameDirectory": true,
  "sources": [
    {
      "source": "./",
      "target": "./",
      "rename": {
        "src.slnx": "YourProjectName.slnx"
      },
      "exclude": [
        "**/[Bb]in/**",
        "**/[Oo]bj/**",
        ".template.config/**/*",
        "**/*.filelist",
        "**/*.user",
        "**/*.lock.json",
        "**/.git/**",
        "**/.logs/**",
        "**/.containers/**"
      ]
    }
  ]
}
